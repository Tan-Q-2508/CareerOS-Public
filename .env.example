# Copy to .env for local development. Never commit the real .env.

# Supabase — from Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server
NODE_ENV=development
PORT=3000

# Admin-grant endpoint (Phase 1 COS crediting, spec 13.4). A long random secret.
# Required in the X-Admin-Secret header on POST /api/admin/grant-cos.
ADMIN_SECRET=generate-a-long-random-string

# AI provider — Gemini (spec 16.7). Mode is "vertex" or "developer".
GEMINI_CONNECTION_MODE=vertex

# vertex mode (Google Cloud Vertex AI, service account) — active mode:
GCP_PROJECT_ID=your-gcp-project-id
GCP_VERTEX_LOCATION=global
# The service-account JSON key, as a single-line string (Render can't mount a file).
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account", ...}

# developer mode (Gemini Developer API, AI Studio) — dormant fallback, kept in case
# vertex billing ever needs to be unlinked again; used only if GEMINI_CONNECTION_MODE=developer:
GEMINI_API_KEY=your-ai-studio-key

# Core Scraper sourcing — the always-on house source via JSearch (RapidAPI).
# Subscribe to JSearch on RapidAPI and paste the key. Without it, Core Scraper is
# unavailable (scans that select it 503) and only BYO Scraper actors work.
RAPIDAPI_KEY=your-rapidapi-jsearch-key

# BYO Scraper sourcing (Apify) — optional. Only relevant if a user connects their
# own LinkedIn/Indeed/etc. Apify actor as a BYO Scraper (their key is encrypted per
# actor; this env var is no longer used for a shared preset).
APIFY_TOKEN=apify_api_your-token

# BYO Scraper multi-actor runtime: master key that encrypts users' own scraper
# keys at rest (AES-256-GCM). 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, users can't add their own actors at all — there is no built-in
# preset to fall back to any more (the LinkedIn one was removed when Core Scraper
# became the house source). A managed-KMS envelope swap is Phase 7 (build order
# item 40), gated on a real security trigger rather than a phase boundary (13.7).
CREDENTIALS_MASTER_KEY=your-base64-32-byte-key

