      "rejectPatterns": {
        "no_sponsorship": [
          "\\b(?:no|not|ineligible|cannot|can't|will not|won't|do not|don't|does not|doesn't|unable to|not able to|without|no longer)\\b (?:[\\w/'\"-]+,? ){0,8}sponsor(?:s|ed|ing|ship)?\\b",
          "\\bsponsorship\\W{0,3}(?:is |are |will be )?(?:not (?:available|provided|offered|possible|supported)|unavailable|no\\b|n/a\\b)",
          "\\bsponsorship (?:will|can|could|shall) not be (?:provided|offered|available|considered|supported|possible)",
          "\\b(?:unable to|not able to|cannot|can't|will not|won't|do not|does not|are not|is not|not) (?:currently )?(?:consider|accept|hire|hiring|considering|accepting|move forward with|able to consider)[^.]{0,60}\\b(?:who|that)\\b[^.]{0,60}\\b(?:require|need|requiring|needing)[^.]{0,60}\\bsponsor",
          "\\b(?:require|need|requires|needs)[^.]{0,30}\\bsponsorship[^.]{0,60}\\b(?:not eligible|ineligible|will not be considered|cannot be considered|are not eligible)",
          "\\b(?:require|requires|required|must (?:have|possess|hold)|possess|need)\\b[^.]{0,40}\\bunrestricted\\b[^.]{0,30}\\bwork authori[sz]ation",
          "\\bunrestricted permanent (?:us |united states )?work authori[sz]ation",
          "\\bnot (?:be )?able to\\b[^.]{0,160}\\bsupport (?:future |any )?(?:h1b |visa |immigration |employment )?sponsorship",
          "\\b(?:must|required to|need to|should|shall) be (?:legally )?authori[sz]ed to work (?:in the (?:us|united states) )?for any (?:us |united states )?employer\\b"
        ],
        "citizen_only": [
          "\\b(?:must|required to|need to|should|shall) (?:be|hold|have|possess|maintain)[^.]{0,30}\\b(?:us|united states|american) (?:citizen|citizenship|national)",
          "\\b(?:us|united states) citizenship\\b[^.]{0,60}\\b(?:is |are )?(?:required|mandatory|a requirement)",
          "\\b(?:us|united states) citizens? only\\b",
          "\\b(?:open|available|limited|restricted) (?:only )?to (?:us |united states )?citizens\\b",
          "\\bcitizens?\\b[^.]{0,120}\\b(?:refugees?|asylees?|asylum|green card holders?|permanent residents?)\\b[^.]{0,40}\\bonly\\b",
          "\\bgreen card holders? only\\b",
          "\\bcitizens?, (?:lawful |us )?permanent residents?,? (?:or|and) (?:protected individuals|refugees|asylees)"
        ],
        "us_person_export": [
          "\\bus persons?\\b[^.]{0,40}\\b(?:as defined|under|only|required|within the meaning)",
          "\\b(?:must|required to|need to) (?:be|qualify as) (?:a )?us person",
          "\\b(?:itar|export control\\w*|export administration)\\b[^.]{0,160}\\b(?:must be|required to be|restricted to|limited to|only)\\b[^.]{0,60}\\b(?:us persons?|us citizens?|citizens?)\\b",
          "\\brequires? access to (?:us )?export[- ]controlled\\b"
        ],
        "clearance": [
          "\\b(?:active|current|existing|interim|final|must (?:have|hold|possess|obtain|be able to obtain|maintain)|ability (?:and willingness )?to obtain|eligib(?:le|ility) (?:to obtain|for)|requires?|required)\\b[^.]{0,60}\\b(?:secret|ts/sci|ts sci|top secret|security|dod|government|federal|public trust)\\b[^.]{0,20}\\bclearances?\\b",
          "\\b(?:required )?clearance(?: level)?(?: required)?\\s*:\\s*\"?(?:secret|ts|top secret|ts/sci|active|yes|public trust|confidential|q\\b|l\\b)"
        ]
      },
      "sponsorGuardPattern": "\\b(?:executive|project|program|business|corporate|event|affinity|clinical|study|trial|internal|key|senior|stakeholders?|team|customer|client|research|and)[\\s-]+sponsors?\\b(?!ship)|\\b(?:company|employee|employer)[\\s-]sponsored\\b|\\bsponsor[\\s-]dedicated",
