# Copy to .env.local for local dev (gitignored). All VITE_* vars are embedded in
# the built client bundle — only ever put PUBLIC values here.

# The CareerOS API (Express server, apps/server).
#
# This defaults to LOCALHOST on purpose. A dev server pointed at production is
# the single most expensive misconfiguration in this repo: the browser renders
# production data while a local server change sits unused, and the two look like
# they disagree about the same number rather than like they are two servers.
# Point it at production ONLY to verify an already-deployed change through the
# local UI, and put it back afterwards:
#   VITE_API_BASE_URL=https://careeros-server.onrender.com
#
# The DEPLOYED bundle never reads this file — render.yaml's careeros-web service
# sets VITE_API_BASE_URL at build time.
VITE_API_BASE_URL=http://localhost:3000

# Supabase project — Project Settings → API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# The PUBLISHABLE key (sb_publishable_...), NOT the secret/service key. Safe to ship.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
